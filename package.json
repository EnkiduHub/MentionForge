{
  "name": "mentionforge",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "Highest-quality, lowest-latency, agent-optimized social listening and company research. Structured, cited, multi-source intelligence in a single x402-paid call.",
  "license": "MIT",
  "homepage": "https://mentionforge.mentionforge.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnkiduHub/MentionForge.git"
  },
  "bugs": {
    "url": "https://github.com/EnkiduHub/MentionForge/issues"
  },
  "bin": {
    "mentionforge": "./scripts/glama-stdio.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/glama-stdio.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "types": "wrangler types",
    "check": "wrangler check",
    "test": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "d1:local": "wrangler d1 migrations apply mentionforge --local",
    "seed-bazaar": "tsx scripts/seed-bazaar.ts",
    "test-payment": "tsx scripts/test-payment.ts",
    "fund-seed-payer": "tsx scripts/fund-seed-payer.ts",
    "purge:forbidden": "tsx scripts/purge-forbidden-cache.ts",
    "secret-scan": "bash scripts/check-secrets.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "@x402/hono": "^2.28.0",
    "@x402/mcp": "^2.28.0",
    "agents": "^0.29.0",
    "hono": "^4.13.13",
    "mcp-remote": "0.14.5",
    "viem": "^2.57.7",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "^22.20.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "zod": "^4.5.0",
    "miniflare": {
      "zod": "^3.25.0"
    },
    "wrangler": {
      "zod": "^3.25.0"
    }
  }
}
